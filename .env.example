# --- Database: MySQL 8.0.16+ (or MariaDB 10.5+). Copy this file to .env and fill in YOUR values; .env is git-ignored. ---
OPSPILOT_DB_HOST=127.0.0.1
OPSPILOT_DB_PORT=3306
OPSPILOT_DB_NAME=opspilot
OPSPILOT_DB_USER=opspilot
OPSPILOT_DB_PASSWORD=                   # required; any characters are fine (escaped for you)
# OPSPILOT_DB_SSL_CA=/path/to/ca.pem    # optional: require TLS to the server (recommended off-box / managed MySQL)
# OPSPILOT_DB_POOL_SIZE=10              # optional connection-pool tuning
# OPSPILOT_DB_MAX_OVERFLOW=20
# OPSPILOT_DATABASE_URL=                # optional: a full SQLAlchemy URL, e.g. mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4 (overrides the parts above)

# --- Test database (used only by pytest; its name MUST contain "test" because the tests drop and recreate its tables) ---
OPSPILOT_TEST_DB_HOST=127.0.0.1
OPSPILOT_TEST_DB_PORT=3306
OPSPILOT_TEST_DB_NAME=opspilot_test
OPSPILOT_TEST_DB_USER=opspilot
OPSPILOT_TEST_DB_PASSWORD=

# --- Docker Compose only: the bundled MySQL container's root password (never used by the app) ---
# MYSQL_ROOT_PASSWORD=


# --- Authentication (off by default for local development) ---
# OPSPILOT_AUTH_ENABLED=true
# OPSPILOT_JWT_SECRET=            # >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OPSPILOT_BOOTSTRAP_ADMIN_USER=admin          # creates the first admin on startup when no users exist
# OPSPILOT_BOOTSTRAP_ADMIN_PASSWORD=           # min 10 chars; remove these two lines after first start
# OPSPILOT_API_KEY=               # with auth on, this key lets the mail poller / folder watcher POST /emails and nothing else
# OPSPILOT_COOKIE_SECURE=true     # required when OPSPILOT_ENV=production (serve over HTTPS)
# OPSPILOT_ENV=production         # refuses to start without auth + secure cookies

# --- Guest access for a public showcase, e.g. a LinkedIn link (docs/GUEST_DEMO.md). Off by default. ---
# A "Try the live demo" button starts a read-only session with sample data: no password, no account, never more than a viewer.
# Requires OPSPILOT_AUTH_ENABLED=true; refuses to start with demo mode, with OPSPILOT_IMAP_* set, or with out-of-range limits.
# Use a SEPARATE database that holds sample data only. Nothing below is a secret.
# OPSPILOT_GUEST_ENABLED=true
# OPSPILOT_GUEST_SESSION_MINUTES=60          # length of one guest session (1-240)
# OPSPILOT_GUEST_EPOCH=1                     # raise it (e.g. to 2) and restart to end every open guest session at once
# OPSPILOT_GUEST_LOGINS_PER_MINUTE_PER_IP=10
# OPSPILOT_GUEST_LOGINS_PER_MINUTE_GLOBAL=120
# OPSPILOT_GUEST_CHAT_PER_SESSION=15         # AI questions per guest session (each one costs Groq tokens)
# OPSPILOT_GUEST_SEARCH_PER_SESSION=30       # document searches per guest session
# OPSPILOT_GUEST_CHAT_PER_DAY_GLOBAL=500     # AI questions all guests together per UTC day: your hard ceiling on Groq cost
# OPSPILOT_GUEST_SEED_ON_START=true          # load sample invoices (and sample documents if RAG is on) when the database is empty
# OPSPILOT_GUEST_SAMPLE_DOCS_DIR=docs/sample_documents

# --- Model Context Protocol (MCP) server: read-only tools for AI assistants (docs/MCP.md). Off by default. ---
# Requires OPSPILOT_AUTH_ENABLED=true; refuses to start otherwise, and cannot be combined with demo mode.
# OPSPILOT_MCP_ENABLED=true
# OPSPILOT_MCP_SYSTEM_KEY=        # >= 32 random chars (python -c "import secrets; print(secrets.token_urlsafe(48))"); Bearer key of the read-only 'system' role. Must differ from OPSPILOT_API_KEY
# OPSPILOT_MCP_STDIO_TOKEN=       # only for `python -m app.mcp_server`: a user JWT (POST /auth/login) or the system key
# OPSPILOT_MCP_ALLOWED_ORIGINS=   # comma-separated browser origins allowed to call POST /mcp (empty = browsers refused; desktop/script clients send no Origin)
# OPSPILOT_MCP_RATE_LIMIT_PER_MINUTE=60
# OPSPILOT_MCP_MAX_MESSAGE_BYTES=65536

# --- AI assistant (Groq) on top of the MCP tools (docs/CHAT.md). Off by default. ---
# Requires OPSPILOT_AUTH_ENABLED=true; refuses to start otherwise or in demo mode. Questions and the records needed to answer them are sent to Groq.
# OPSPILOT_CHAT_ENABLED=true
# OPSPILOT_GROQ_API_KEY=          # create at https://console.groq.com/keys (starts with gsk_)
# OPSPILOT_GROQ_MODEL=openai/gpt-oss-120b   # any Groq model that supports tool calling
# OPSPILOT_CHAT_FACT_CHECK=true  # second model call that checks every statement against the records
# OPSPILOT_CHAT_RATE_LIMIT_PER_MINUTE=20
# OPSPILOT_CHAT_TIMEOUT_SECONDS=30
# Groq's free tier limits tokens per minute per model. On HTTP 429 the client waits the time Groq asks for and retries:
# OPSPILOT_CHAT_RATE_LIMIT_RETRIES=2
# OPSPILOT_CHAT_RATE_LIMIT_MAX_WAIT_SECONDS=12
# Fewer tokens per question: how much earlier conversation is re-sent on every model call
# Answer what fixed rules can (greetings, counts, lists, quoted policy sentences) WITHOUT the AI model; the model is used last:
# OPSPILOT_CHAT_HARDCODE=true
# OPSPILOT_RAG_ANSWER_MODE=auto                  # auto = quote documents when a sentence answers, else one model call; llm = always the model
# OPSPILOT_RAG_DIRECT_MIN_OVERLAP=0.5
# OPSPILOT_CHAT_HISTORY_TURNS=6
# OPSPILOT_CHAT_HISTORY_CHARS=500

# --- Document search (RAG) for the assistant (docs/RAG.md). Off by default. Free and local: Sentence Transformers embeddings run on
# this machine, FAISS is a library, and the only external call is the Groq chat model the assistant already uses. ---
# Requires OPSPILOT_AUTH_ENABLED=true; refuses to start otherwise or in demo mode. Passages the user may see are sent to Groq with the question.
# OPSPILOT_RAG_ENABLED=true
# OPSPILOT_RAG_DATA_DIR=data/rag                 # FAISS index; derived data, rebuild with POST /rag/reindex
# OPSPILOT_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # downloaded once from Hugging Face (free), then cached
# OPSPILOT_RAG_EMBEDDING_LOCAL_FILES_ONLY=false  # true = never contact Hugging Face (model must be cached or a local folder)
# OPSPILOT_RAG_MIN_SCORE=0.30                    # relevance floor (cosine); tune with python -m scripts.evaluate_retrieval
# OPSPILOT_RAG_TOP_K=5
# OPSPILOT_RAG_MIN_SUPPORT=0.40                  # answer-sentence word-support check; 0 turns it off
# OPSPILOT_RAG_MAX_UPLOAD_BYTES=10000000
# OPSPILOT_RAG_PRELOAD=false                     # true = load the embedding model at start-up instead of on the first question
